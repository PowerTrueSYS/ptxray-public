{
  "id": "ck-rhosts",
  "pillar": "security",
  "category": "security",
  "finding_ids": [
    "rhosts"
  ],
  "captures": [],
  "requires_root": true,
  "read_only": true,
  "commands": [
    "sh -c 'find / -name .rhosts -print 2>/dev/null; echo __ptxray_find_end__'",
    "sh -c 'find / -name .shosts -print 2>/dev/null; echo __ptxray_find_end__'",
    "sh -c 'find / -name hosts.equiv -print 2>/dev/null; echo __ptxray_find_end__'",
    "sh -c 'find / -name shosts.equiv -print 2>/dev/null; echo __ptxray_find_end__'"
  ],
  "tags": [
    "stig:V-215432"
  ],
  "blurb": "The .rhosts, .shosts, hosts.equiv and shosts.equiv files list hosts that are trusted to log in without a password. If any of them is present anywhere on the system, anyone who compromises one of those hosts can move laterally onto this system with no password check.",
