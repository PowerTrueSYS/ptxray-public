  "commands": [
    "find / -name passwd.nntp \\( -fstype jfs -o -fstype jfs2 \\) -exec ls -lL {} \\;"
  ],
  "tags": [
    "stig:V-215327"
  ],
  "severity": "medium",
  "blurb": "This check verifies that every passwd.nntp file on jfs/jfs2 has mode 0600 or less permissive. When no such file exists, NNTP is treated as not in use.",
