{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://powertruesystems.com/ptxray/#software",
  "name": "PTxray",
  "alternateName": "PTxray AIX and IBM i posture assessment",
  "description": "PTxray 1.8.1 provides full report bundles for IBM AIX and IBM i. A separate downloader acquires verified inputs before assessment. Assessment probes change no system configuration, perform no remediation, make no network calls, and send no assessment data or telemetry away from the host.",
  "url": "https://powertruesystems.com/ptxray/",
  "codeRepository": "https://github.com/PowerTrueSYS/ptxray-public",
  "softwareVersion": "1.8.1",
  "applicationCategory": "System administration and security assessment",
  "applicationSubCategory": "IBM AIX and IBM i health check and posture assessment",
  "operatingSystem": [
    "IBM AIX 7.2",
    "IBM AIX 7.3",
    "IBM i 7.4",
    "IBM i 7.5"
  ],
  "programmingLanguage": "KornShell; AIX FLRTVC requires native ksh93; IBM i uses PASE ksh",
  "softwareRequirements": "AIX 7.2 or 7.3 with root, native ksh93 and supported OpenSSL; connected acquisition also needs curl and unzip. IBM i 7.4 or 7.5 requires PASE ksh and QSECOFR as session and effective user; see the bundle README for SQL services and tools. Extract the complete signed report bundle. VIOS assessment is disabled.",
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "provider": {
    "@type": "Organization",
    "@id": "https://powertruesystems.com/#org",
    "name": "PowerTrue Systems",
    "url": "https://powertruesystems.com"
  },
  "featureList": [
    "Read-only assessment without network calls, remediation, or assessment-data upload",
    "Complete AIX and IBM i report bundles with HTML and JSON outputs",
    "Automatic offline IBM FLRTVC execution on AIX after separate verified engine and definition acquisition",
    "Full IBM i catalog selection with explicit CIS L1 and L2 subsets",
    "Protected same-package definitions helper verified against its SHA-256 pin before execution",
    "Offline assessments use verified cached or locally transferred signed inputs",
    "Unavailable evidence remains NOT_ASSESSED; stale data cannot support a clean vulnerability conclusion",
    "Platform-specific standards alignment and disclosed coverage, not compliance certification",
    "585 standalone check tools with machine-readable command manifests"
  ],
  "keywords": "IBM AIX health check, IBM i assessment, IBM i posture assessment, IBM Power security audit, AIX posture assessment, AIX risk scanner, DISA STIG IBM AIX 7.x, CIS IBM AIX 7, CIS IBM i, CIS L1-aligned checks, ksh88, read-only assessment, air-gapped assessment",
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "licenseExpression",
      "value": "Apache-2.0"
    },
    {
      "@type": "PropertyValue",
      "name": "standaloneCheckCount",
      "value": 585
    },
    {
      "@type": "PropertyValue",
      "name": "configurationEffect",
      "value": "read-only"
    },
    {
      "@type": "PropertyValue",
      "name": "assessmentNetworkEgress",
      "value": "none"
    },
    {
      "@type": "PropertyValue",
      "name": "definitionsCacheWrite",
      "value": "/var/ptxray/definitions before assessment"
    }
  ]
